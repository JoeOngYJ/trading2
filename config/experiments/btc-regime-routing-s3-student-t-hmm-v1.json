  "economic_hypothesis": "A causally fitted persistent heavy-tailed two-state model can identify forward BTC stress risk that is not captured by the frozen EWMA level alone, and continuously reduce EWMA-sized exposure during stress without changing breakout direction, timestamps, or entry eligibility.",
  "experiment_id": "btc-regime-routing-s3-student-t-hmm-v1",
  "features": {
    "availability": "Each feature row uses only completed official UTC daily bars and becomes available at the close of its latest bar.",
    "definitions": [
      {
        "feature_id": "realized_volatility_ratio_10_60",
        "formula": "sqrt(mean(last 10 close-to-close log returns squared) / mean(last 60 close-to-close log returns squared))"
      },
      {
        "feature_id": "downside_semivariance_share_20",
        "formula": "sum(last 20 squared close-to-close log returns where return < 0) / sum(last 20 squared close-to-close log returns)"
      },
      {
        "feature_id": "high_low_range_ratio_10_60",
        "formula": "sqrt(mean(last 10 squared log(high / low)) / mean(last 60 squared log(high / low)))"
      },
      {
        "feature_id": "normalized_jump_magnitude_1_60",
        "formula": "absolute latest close-to-close log return / sqrt(mean(last 60 close-to-close log returns squared))"
      }
    ],
    "minimum_completed_returns": 60,
    "nonpositive_denominator_behavior": "unknown",
    "reset_on_daily_gap": true
  },
  "fitting": {
    "canonical_label_rule": "At every refit, ordinary_risk is the state with the lower arithmetic mean of its four standardized emission-location coordinates; ties use lower summed diagonal variance then original state index.",
    "covariance": "diagonal",
    "degrees_of_freedom": 5,
    "emission": "multivariate_independent_student_t",
    "initial_state_probabilities": [
      0.5,
      0.5
    ],
    "initial_transition_matrix": [
      [
        0.97,
        0.03
      ],
      [
        0.03,
        0.97
      ]
    ],
    "initialization": "Split the robust-scaled training rows at the median arithmetic mean of their four coordinates; initialize each state's location and diagonal variance from its deterministic half.",
    "maximum_em_iterations": 100,
    "minimum_self_transition_probability": 0.9,
    "minimum_training_observations": 365,
    "optimizer": "one deterministic Baum-Welch EM run; no restarts and no alternative selection",
    "refit_cutoff": "first UTC midnight of each calendar month",
    "refit_schedule": "monthly expanding window",
    "scaler": {
      "clip_absolute_scaled_value": 8,
      "dispersion": "1.4826 * median absolute deviation",
      "dispersion_floor": 1e-06,
      "location": "median",
      "training_rows": "strictly available before the monthly refit cutoff"
    },
    "transition_pseudocounts": {
      "self": 20,
      "switch": 1
    },
    "variance_ceiling": 100,
    "variance_floor": 0.0001
  },
