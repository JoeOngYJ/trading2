  },
  "sampling": {
    "decision_frequency_ms": 1000,
    "utc_anchor": true,
    "availability_timestamp": "local_receipt_time_ns",
    "maximum_book_age_ms": 500,
    "trailing_window_left_open_right_closed": true,
    "segment_crossing_allowed": false
  },
  "features": {
    "primary_l2": [
      "queue_imbalance_l1",
      "ofi_l1_sum_1s",
      "microprice_minus_mid_spreads"
