    "signed_trade_control": [
      "signed_trade_quote_qty_1s",
      "trade_count_1s",
      "absolute_trade_quote_qty_1s",
      "return_1s"
    ],
    "state_controls": [
      "spread",
      "l1_total_depth",
      "depth_event_count_1s",
      "book_age_ms",
      "realized_volatility_10s"
    ],
    "secondary_diagnostics": [
      "queue_imbalance_l5",
