    "regularization_grid": [0.01, 0.1, 1, 10]
  },
  "decision_gates": {
    "incremental_primary_oos_r_squared_positive": true,
    "day_block_bootstrap_lower_95_above_zero": true,
    "positive_development_folds_minimum": 3,
    "single_day_or_state_concentration_rejected": true,
    "classification_metrics_must_not_contradict_regression": true
  },
  "promotion_eligible": false,
  "blockers": [
    "OB0 is acquisition validation only.",
