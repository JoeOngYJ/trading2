  "decision_rule": {
    "day_acceptance_requires": [
      "hour_gate_passes_for_all_24_hours",
      "all_48_declared_objects_are_present_and_checksummed",
      "no_unsegmented_update_id_gap_within_or_across_hours",
      "snapshot_or_explicit_segment_boundary_initializes_each_discontinuity",
      "accepted_replay_is_positive_uncrossed_and_deterministic",
      "received_time_coverage_has_no_unexplained_interval_over_one_second",
      "trade_and_orderbook_received_time_ranges_overlap_each_hour"
    ],
    "fail_closed": true,
    "hour_acceptance_requires": [
      "both_declared_objects_are_present_and_checksummed",
      "zstd_streams_decompress_to_valid_parquet",
      "documented_required_columns_are_present",
      "role_required_values_are_non_null_and_finite",
      "timestamps_are_utc_hour_bounded_and_non_decreasing",
      "received_time_is_not_earlier_than_exchange_event_time",
      "prices_are_positive_and_quantities_are_non_negative",
      "native_first_and_final_update_ids_are_present_and_valid",
      "update_groups_are_contiguous_or_explicitly_segmented",
      "a_snapshot_or_equivalent_last_update_id_initializes_replay",
      "reconstructed_book_is_positive_and_uncrossed",
      "trade_ids_are_strictly_increasing",
      "provider_terms_allow_internal_research_and_retention"
    ],
    "normalized_source_can_satisfy_exchange_native_raw_contract": false,
    "provider_audit_is_not_ob0_ob1_or_strategy_evidence": true
  },
  "frozen_at": "2026-08-29T01:10:00Z",
  "hypothesis": "The free CryptoHFTData Binance spot BTCUSDT hourly order-book and trade files preserve enough point-in-time sequence, snapshot, receipt-time, and trade identity information for deterministic replay fixtures. Reject the source if the frozen example hour cannot reconstruct without an unlocated gap; inspect the remaining hours of the exact day only if that hour passes, and do not treat normalized provider data as exchange-native raw evidence.",
