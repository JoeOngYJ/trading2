# Local research credentials template.
# Copy to an untracked file such as /data/Trading/.env.local and chmod 600.
# Never commit the copied file, paste secrets into chat, or use this template in production.

# Alpha Vantage news/sentiment
ALPHAVANTAGE_API_KEY=

# Twelve Data offline market-data research
TWELVEDATA_API_KEY=

# Optional commercial news provider (only after licensing approval)
NEWS_PROVIDER_API_KEY=
NEWS_PROVIDER_BASE_URL=

# Optional Reddit/social research access
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# Optional CoinGecko/CoinAPI/Kaiko research access
COINGECKO_API_KEY=
COINAPI_API_KEY=
KAIKO_API_KEY=

# Platform runtime settings
PLATFORM_ENVIRONMENT=synthetic
PLATFORM_SECRET_DIR=/run/secrets
PLATFORM_ALLOW_ENV_SECRETS=0
