      "monkey_patching",
      "object___setattr__",
      "arbitrary_process_memory_mutation"
    ]
  },
  "qualification_authority": {
    "candidate_component_id": false,
    "id": "Q0",
    "implementation_import_allowed": false,
    "input": "frozen_authorities_plus_canonical_emitted_JSON",
    "oracle_values_created_only_after_candidate_snapshot": true,
    "responsibility": "independent_closed_form_oracle_and_mutation_qualification"
  },
  "row_lineage": {
    "always_required": [
      "run_context_digest",
      "complete_implementation_manifest_digest",
      "before_state_digest",
      "after_state_digest",
      "row_digest",
      "event_sequence",
      "row_kind"
