    "event_specific_required_or_not_applicable": [
      "source_digest",
      "instrument_rule_digest",
      "margin_rule_digest",
      "selected_mandate_digest",
      "semantic_settings_digest",
      "execution_scenario_digest",
      "mark_index_or_funding_source_digest"
    ],
    "row_kind_timestamp_rules": {
      "account_or_margin_checkpoint": {
        "forbidden": [
          "decision_at_UTC",
          "execution_at_UTC"
        ],
        "required": [
          "economic_at_UTC",
          "available_at_UTC"
        ]
      },
      "decision_or_order": {
        "forbidden": [
          "execution_at_UTC",
          "funding_effective_at_UTC"
        ],
        "required": [
          "decision_at_UTC",
          "available_at_UTC"
        ]
      },
      "fill": {
        "forbidden": [
          "funding_effective_at_UTC"
        ],
        "required": [
          "decision_at_UTC",
          "available_at_UTC",
          "execution_at_UTC"
        ]
      },
      "funding": {
        "forbidden": [
          "decision_at_UTC",
          "execution_at_UTC"
        ],
        "required": [
          "available_at_UTC",
          "funding_effective_at_UTC"
        ]
      },
      "terminal": {
        "forbidden": [
          "decision_at_UTC",
          "funding_effective_at_UTC"
        ],
        "required": [
          "available_at_UTC",
          "economic_at_UTC"
        ]
      }
    }
  },
